PORT = 3000

# Required: remote PostgreSQL connection string (e.g. Supabase).
# The app connects with SSL and forces a single routable IP at startup, so
# the direct host (db.<project-ref>.supabase.co) is fine when IPv6 is
# reachable; otherwise use the IPv4 pooler endpoint of the same project.
DATABASE_URL = postgresql://postgres.<project-ref>:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Generate strong random values for both, e.g.: openssl rand -base64
JWT_SECRET = your-strong-jwt-secret
API_KEY = your-strong-api-key

# Optional: comma-separated list of allowed browser origins (CORS).
# Leave unset to allow all origins. On Render, set it to your frontend URL,
# e.g. https://student-db-frontend.onrender.com
CORS_ORIGIN =