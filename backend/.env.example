PORT = 3000

# Remote PostgreSQL (e.g. Supabase). The app uses DATABASE_URL when set.
# Direct host: postgresql://postgres:your-password@db.<project-ref>.supabase.co:5432/postgres
# (note: some Supabase projects expose the direct host over IPv6 only;
#  if your network has no IPv6 route, use the IPv4 pooler endpoint instead)
DATABASE_URL = postgresql://postgres.<project-ref>:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Optional fallback when DATABASE_URL is not set (local dev)
PGPORT = 5432
PGHOST = localhost
PGUSER = postgres
PGPASSWORD = your-password
PGDATABASE = your-db

# Generate strong random values for both, e.g.: openssl rand -base64
JWT_SECRET = your-strong-jwt-secret
API_KEY = your-strong-api-key